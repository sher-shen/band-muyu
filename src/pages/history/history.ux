<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 返回</text>
      </div>
      <text class="title">每日功德</text>
    </div>
    <list class="list" onswipe="onSwipe">
      <list-item type="row" class="row" for="{{rows}}">
        <text class="d">{{$item.date}}</text>
        <text class="c">{{$item.count}}</text>
      </list-item>
      <list-item type="clear" class="clear-row">
        <div class="btn {{holding ? 'btn-hold' : ''}}" ontouchstart="wipeStart" ontouchmove="wipeMove" ontouchend="wipeCancel" ontouchcancel="wipeCancel">
          <text class="btn-text">长按清空历史</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { holdStart, holdMove, holdCancel } from '../../common/hold.js'
import { loadHistory, clearHistory } from '../../common/store.js'

export default {
  private: {
    rows: [],
    holding: false
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    holdCancel(this, 'holding')
  },

  onDestroy() {
    holdCancel(this, 'holding')
  },

  async refresh() {
    this.rows = await loadHistory()
  },

  goBack() {
    router.back()
  },

  // swipe 事件不冒泡，所以页面和列表上都挂了这个处理
  onSwipe(e) {
    if (e.direction === 'right') router.back()
  },

  wipeStart(e) {
    holdStart(this, 'holding', e, () => this.wipe())
  },

  wipeMove(e) {
    holdMove(this, 'holding', e)
  },

  wipeCancel() {
    holdCancel(this, 'holding')
  },

  async wipe() {
    await clearHistory()
    vibrator.vibrate({ mode: 'long' })
    this.refresh()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.header {
  width: 100%;
  height: 70px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
}

.back {
  position: absolute;
  left: 10px;
  top: 10px;
  height: 50px;
  padding-left: 12px;
  padding-right: 12px;
  justify-content: center;
}

.back-text {
  font-size: 22px;
  color: #aaaaaa;
}

.title {
  font-size: 26px;
  color: #ffd27a;
}

.list {
  width: 336px;
  height: 400px;
}

.row {
  width: 336px;
  flex-direction: row;
  justify-content: space-between;
  padding-left: 30px;
  padding-right: 30px;
  height: 56px;
  align-items: center;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}

.d {
  font-size: 22px;
  color: #cccccc;
}

.c {
  font-size: 26px;
  color: #ffffff;
}

.clear-row {
  width: 336px;
  height: 110px;
  justify-content: center;
  align-items: center;
}

.btn {
  width: 220px;
  height: 52px;
  border-radius: 26px;
  background-color: #5a1e1e;
  justify-content: center;
  align-items: center;
}

.btn-hold {
  background-color: #a83232;
}

.btn-text {
  font-size: 22px;
  color: #ffffff;
}
</style>
